# URL pública do site (sem barra no final). Necessária para Open Graph em produção.
VITE_SITE_URL=

# Preencha apenas os IDs que você tiver. Não é necessário usar os três ao mesmo tempo.
# Se o GTM já contiver o GA4, deixe VITE_GA4_ID vazio para evitar duplicidade.
VITE_GTM_ID=
VITE_GA4_ID=
# Pixel já está no index.html (1784657622736445). Não preencha aqui para evitar PageView duplicado.
VITE_META_PIXEL_ID=
